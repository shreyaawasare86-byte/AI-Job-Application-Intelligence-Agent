# AI Job Application Intelligence Agent Configuration

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp, etc.
GEMINI_MODEL=gemini-1.5-flash

# LLM Provider: "gemini" or "mock" (offline fallback)
LLM_PROVIDER=gemini

# Application Environment: development, production, test
ENVIRONMENT=development

# Database path for SQLite Application Tracker
DATABASE_PATH=data/applications.db

# Cache LLM responses to reduce latency & cost (True/False)
ENABLE_LLM_CACHE=True
CACHE_DIR=data/cache

# API Port & Host
API_HOST=127.0.0.1
API_PORT=8000
